{
    "model": "XGBoost",
    "window_size": 7,
    "features": [
        "Port_Congestion",
        "geopolitical_risk",
        "weather_severity",
        "Supplier_Reliability",
        "Supplier_Capacity_Utilization",
        "Inventory_Level",
        "Demand_Volatility",
        "Lead_Time_Days",
        "Shipping_Cost_Index"
    ],
    "target": "Risk_Level",
    "label_map": {
        "High": 0,
        "Low": 1,
        "Medium": 2
